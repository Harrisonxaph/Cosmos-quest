{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cosmos Quest planets",
  "type": "array",
  "minItems": 8,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "orderFromSun",
      "facts"
    ],
    "properties": {
      "id": {
        "enum": [
          "mercury",
          "venus",
          "earth",
          "mars",
          "jupiter",
          "saturn",
          "uranus",
          "neptune"
        ]
      },
      "name": {
        "enum": [
          "Mercury",
          "Venus",
          "Earth",
          "Mars",
          "Jupiter",
          "Saturn",
          "Uranus",
          "Neptune"
        ]
      },
      "orderFromSun": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "facts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "sourceId"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 10
            },
            "sourceId": {
              "type": "string",
              "pattern": "^nasa-[a-z]+$"
            }
          }
        }
      }
    }
  }
}
